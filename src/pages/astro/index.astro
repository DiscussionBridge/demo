---
import DemoCard from "../../components/DemoCard.astro";
import { astroDemos } from "../../data/demo-estate";
import DemoLayout from "../../layouts/DemoLayout.astro";
---

<DemoLayout title="Astro demos · DiscussionBridge" description="Explore the inaugural Astro + Starlight product, plain Astro reference, stock Starlight control, and planned themed edition." activePath="/astro/">
  <section class="page-intro">
    <p class="kicker">Inaugural platform product</p>
    <h1>DiscussionBridge for Astro</h1>
    <p>DiscussionBridge for Astro + Starlight is the inaugural standalone product: useful with standard Discourse and Bridge-enhanced by choice. The live reference and control profiles will be joined by a full native theme that can begin as a polished placeholder and grow into the finished site.</p>
  </section>
  <div class="demo-grid">{astroDemos.map((demo) => <DemoCard demo={demo} />)}</div>
</DemoLayout>
