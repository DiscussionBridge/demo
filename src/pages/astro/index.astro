---
import DemoCard from "../../components/DemoCard.astro";
import { astroDemos } from "../../data/demo-estate";
import DemoLayout from "../../layouts/DemoLayout.astro";
---

<DemoLayout title="Astro demos · DiscussionBridge" description="Explore the inaugural Astro + Starlight product, plain Astro reference, and stock Starlight control." activePath="/astro/">
  <section class="page-intro">
    <p class="kicker">Inaugural platform product</p>
    <h1>DiscussionBridge for Astro</h1>
    <p>DiscussionBridge for Astro + Starlight is the inaugural standalone product: useful with standard Discourse, Bridge-enhanced by choice, and supported by a plain Astro reference plus an untouched Starlight comparison control.</p>
  </section>
  <div class="demo-grid">{astroDemos.map((demo) => <DemoCard demo={demo} />)}</div>
</DemoLayout>
