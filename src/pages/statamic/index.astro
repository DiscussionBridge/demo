---
import DemoCard from "../../components/DemoCard.astro";
import { statamicDemos } from "../../data/demo-estate";
import DemoLayout from "../../layouts/DemoLayout.astro";
---

<DemoLayout title="Statamic demos · DiscussionBridge" description="Independent Statamic Flat, DB, and SSG demonstrations with one shared planned themed edition." activePath="/statamic/">
  <section class="page-intro">
    <p class="kicker">Three live profiles</p>
    <h1>One Statamic addon. Three honest proofs.</h1>
    <p>Flat, DB, and SSG share addon code and one Statamic theme, while remaining separate validation profiles with distinct content stores, connections, discussions, persistence, deployment boundaries, and presentation evidence. The planned shared starter adds a complete native design journey from polished placeholder to live site without absorbing the addon.</p>
  </section>
  <div class="demo-grid">{statamicDemos.map((demo) => <DemoCard demo={demo} />)}</div>
</DemoLayout>
