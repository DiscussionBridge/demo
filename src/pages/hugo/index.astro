---
import DemoCard from "../../components/DemoCard.astro";
import { hugoDemos } from "../../data/demo-estate";
import DemoLayout from "../../layouts/DemoLayout.astro";
---

<DemoLayout title="Hugo demo · DiscussionBridge" description="The live stock Hugo publishing profile for DiscussionBridge." activePath="/hugo/">
  <section class="page-intro">
    <p class="kicker">Live Alpha profile</p>
    <h1>Hugo builds the site. The discussion stays connected.</h1>
    <p>The stock Hugo profile now proves generated Simple comments, plugin-free Full comments, stable receiver-backed publishing, and forum-owned content—all without placing credentials in the browser.</p>
  </section>
  <div class="demo-grid">{hugoDemos.map((demo) => <DemoCard demo={demo} />)}</div>
</DemoLayout>
