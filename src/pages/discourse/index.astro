---
import DemoCard from "../../components/DemoCard.astro";
import { discourseDemos } from "../../data/demo-estate";
import DemoLayout from "../../layouts/DemoLayout.astro";

const profiles = [
  { name: "Astro", fullInteractive: "https://astrostarlight.demo.discussionbridge.dev/comments/bridge-publisher/", simple: "https://astrostarlight.demo.discussionbridge.dev/comments/shared-simple/", full: "https://astrostarlight.demo.discussionbridge.dev/comments/shared-full/" },
  { name: "WordPress", fullInteractive: "https://wordpress.demo.discussionbridge.dev/the-bridge-publishes-everywhere/", simple: "https://wordpress.demo.discussionbridge.dev/shared-simple-comments/", full: "https://wordpress.demo.discussionbridge.dev/shared-full-comments/" },
  { name: "Ghost", fullInteractive: "https://ghost.demo.discussionbridge.dev/the-bridge-publishes-everywhere/", simple: "https://ghost.demo.discussionbridge.dev/shared-simple-comments/", full: "https://ghost.demo.discussionbridge.dev/shared-full-comments/" },
  { name: "Statamic Flat", fullInteractive: "https://statamic-flat.demo.discussionbridge.dev/discussionbridge/the-bridge-publishes-everywhere", simple: "https://statamic-flat.demo.discussionbridge.dev/discussionbridge/shared-simple-comments", full: "https://statamic-flat.demo.discussionbridge.dev/discussionbridge/shared-full-comments" },
  { name: "Statamic DB", fullInteractive: "https://statamic-db.demo.discussionbridge.dev/discussionbridge/the-bridge-publishes-everywhere", simple: "https://statamic-db.demo.discussionbridge.dev/discussionbridge/shared-simple-comments", full: "https://statamic-db.demo.discussionbridge.dev/discussionbridge/shared-full-comments" },
  { name: "Statamic SSG", fullInteractive: "https://statamic-ssg.demo.discussionbridge.dev/discussionbridge/the-bridge-publishes-everywhere/", simple: "https://statamic-ssg.demo.discussionbridge.dev/discussionbridge/shared-simple-comments/", full: "https://statamic-ssg.demo.discussionbridge.dev/discussionbridge/shared-full-comments/" },
  { name: "Hugo", fullInteractive: "https://hugo.demo.discussionbridge.dev/discussionbridge/the-bridge-publishes-everywhere/", simple: "https://hugo.demo.discussionbridge.dev/discussionbridge/shared-simple-comments/", full: "https://hugo.demo.discussionbridge.dev/discussionbridge/shared-full-comments/" },
];

const conversations = [
  { key: "fullInteractive", label: "fullInteractive", topic: "https://bridge.demo.discussionbridge.dev/t/the-bridge-publishes-everywhere/53", summary: "One forum-owned publication and live discussion, materialized natively and presented with the complete Bridge experience." },
  { key: "simple", label: "Simple", topic: "https://bridge.demo.discussionbridge.dev/t/one-discussion-seven-simple-presentations/54", summary: "One authoritative topic rendered as lightweight native comment cards on every platform." },
  { key: "full", label: "Full", topic: "https://bridge.demo.discussionbridge.dev/t/one-discussion-seven-full-presentations/56", summary: "One authoritative topic presented through the standard Discourse comments frame on every platform." },
] as const;

const mixedExamples = [
  {
    title: "Two static destinations · two modes",
    topic: "https://bridge.demo.discussionbridge.dev/t/one-discussion-seven-simple-presentations/54",
    summary: "Topic 54 stays Simple on Astro while Hugo deliberately presents that same topic in Full.",
    destinations: [
      { name: "Astro · Simple", href: "https://astrostarlight.demo.discussionbridge.dev/comments/shared-simple/" },
      { name: "Hugo · Full", href: "https://hugo.demo.discussionbridge.dev/discussionbridge/mixed-static-full/" },
    ],
  },
  {
    title: "Three platforms · three modes",
    topic: "https://bridge.demo.discussionbridge.dev/t/one-discussion-seven-full-presentations/56",
    summary: "Topic 56 appears as native Simple cards on WordPress, the standard Full frame on Ghost, and fullInteractive on Statamic DB.",
    destinations: [
      { name: "WordPress · Simple", href: "https://wordpress.demo.discussionbridge.dev/mixed-mode-simple-comments/" },
      { name: "Ghost · Full", href: "https://ghost.demo.discussionbridge.dev/shared-full-comments/" },
      { name: "Statamic DB · fullInteractive", href: "https://statamic-db.demo.discussionbridge.dev/discussionbridge/mixed-mode-fullinteractive" },
    ],
  },
];
---

<DemoLayout title="The Bridge · DiscussionBridge demos" description="DiscussionBridge’s Discourse-powered flagship and live reference forum for connected publishing and authoritative discussion." activePath="/discourse/">
  <section class="page-intro">
    <p class="kicker">DiscussionBridge flagship</p>
    <h1>The Bridge</h1>
    <p>DiscussionBridge’s Discourse-powered flagship and live reference forum—where connected platforms publish, receive, and share authoritative discussions through the same plugin available to operators.</p>
  </section>
  <div class="demo-grid">{discourseDemos.map((demo) => <DemoCard demo={demo} />)}</div>
  <section class="bridge-identity" id="about-the-bridge">
    <p class="kicker">What The Bridge is</p>
    <h2>The flagship forum—not a special-purpose substitute.</h2>
    <p>The Bridge runs the downloadable DiscussionBridge plugin that forum operators use. It receives content from connected platforms, publishes forum-owned content outward, preserves Discourse as the authoritative home of each discussion, and demonstrates how one conversation can appear through different presentation modes across the platform estate.</p>
    <p>It is deliberately separate from the DiscussionBridge community forum, the build sandbox, and the development/pre-production forum. The topics below are working demonstrations; none serves as the product’s About page.</p>
  </section>
  <section class="matrix-intro">
    <p class="kicker">Many-to-many demonstration</p>
    <h2>Three discussions. Seven platform profiles. Twenty-one live presentations.</h2>
    <p>The source topic stays authoritative while every destination chooses the presentation appropriate to its product and audience. These are deliberately shared conversations—not seven copied topics wearing the same title.</p>
  </section>
  <div class="conversation-stack">
    {conversations.map((conversation) => (
      <section class="conversation">
        <header>
          <div><p class="mode">{conversation.label}</p><h3>{conversation.label} everywhere</h3></div>
          <a class="topic-link" href={conversation.topic}>Open source topic</a>
        </header>
        <p>{conversation.summary}</p>
        <div class="profile-grid">
          {profiles.map((profile) => <a href={profile[conversation.key]}><span>{profile.name}</span><small>Open {conversation.label}</small></a>)}
        </div>
      </section>
    ))}
  </div>
  <section class="matrix-intro mixed-intro">
    <p class="kicker">Mix and match</p>
    <h2>The topic is shared. The presentation is chosen.</h2>
    <p>These smaller combinations make the many-to-many model explicit: one source discussion can meet different product needs without becoming a one-size-fits-all widget.</p>
  </section>
  <div class="conversation-stack mixed-stack">
    {mixedExamples.map((example) => (
      <section class="conversation">
        <header><h3>{example.title}</h3><a class="topic-link" href={example.topic}>Open source topic</a></header>
        <p>{example.summary}</p>
        <div class="profile-grid mixed-grid">
          {example.destinations.map((destination) => <a href={destination.href}><span>{destination.name}</span><small>Open presentation</small></a>)}
        </div>
      </section>
    ))}
  </div>
  <section class="access-model">
    <p class="kicker">Access model</p>
    <h2>Public to explore. Controlled to operate.</h2>
    <ul>
      <li>Everyone can read the live publishing and imported-content demonstrations.</li>
      <li>The installed workflow currently operates through the staff-controlled publisher adapter.</li>
      <li>Individual, expiring Demo Publisher credentials and coordinated resets are the next access layer.</li>
      <li>Full Discourse administration and connection secrets remain private.</li>
    </ul>
  </section>
</DemoLayout>

<style>
  .access-model { max-width: 850px; margin-top: 54px; padding: clamp(24px, 5vw, 44px); border-left: 4px solid var(--accent); border-radius: 0 18px 18px 0; background: var(--panel); }
  .access-model h2 { margin: 0; font-family: var(--display-font); font-size: clamp(1.7rem, 4vw, 2.6rem); font-weight: 500; }
  .access-model ul { margin: 20px 0 0; padding-left: 1.2rem; color: var(--muted); }
  .access-model li + li { margin-top: 8px; }
  .matrix-intro { max-width: 920px; margin-top: 64px; }
  .bridge-identity { max-width: 920px; margin-top: 54px; padding: clamp(24px, 5vw, 44px); border: 1px solid var(--line); border-radius: 22px; background: var(--panel); }
  .bridge-identity h2 { margin: 0; font-family: var(--display-font); font-size: clamp(2rem, 5vw, 3.5rem); font-weight: 500; line-height: 1.04; }
  .bridge-identity > p:last-child, .bridge-identity > p:nth-last-child(2) { max-width: 780px; color: var(--muted); font-size: 1.08rem; }
  .matrix-intro h2 { margin: 0; font-family: var(--display-font); font-size: clamp(2rem, 5vw, 3.5rem); font-weight: 500; line-height: 1.04; }
  .matrix-intro > p:last-child { max-width: 760px; color: var(--muted); font-size: 1.08rem; }
  .conversation-stack { display: grid; gap: 24px; margin-top: 28px; }
  .mixed-intro { margin-top: 72px; }
  .mixed-stack { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .conversation { padding: clamp(22px, 4vw, 36px); border: 1px solid var(--line); border-radius: 22px; background: var(--panel); }
  .conversation header { display: flex; align-items: end; justify-content: space-between; gap: 18px; }
  .conversation h3 { margin: 2px 0 0; font-family: var(--display-font); font-size: clamp(1.6rem, 4vw, 2.5rem); font-weight: 500; }
  .conversation > p { max-width: 720px; color: var(--muted); }
  .mode { margin: 0; color: var(--accent); font-size: .76rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
  .topic-link { white-space: nowrap; }
  .profile-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; margin-top: 22px; }
  .profile-grid a { display: grid; gap: 3px; padding: 15px 16px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); color: inherit; text-decoration: none; transition: transform .18s ease, border-color .18s ease; }
  .profile-grid a:hover { transform: translateY(-2px); border-color: var(--accent); }
  .profile-grid span { font-weight: 750; }
  .profile-grid small { color: var(--muted); }
  .mixed-grid { grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); }
  @media (max-width: 820px) { .mixed-stack { grid-template-columns: 1fr; } }
  @media (max-width: 620px) { .conversation header { align-items: start; flex-direction: column; } }
</style>
