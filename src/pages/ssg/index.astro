---
import DemoCard from "../../components/DemoCard.astro";
import { ssgDemos } from "../../data/demo-estate";
import DemoLayout from "../../layouts/DemoLayout.astro";
---

<DemoLayout title="SSG demos · DiscussionBridge" description="Static-generation DiscussionBridge profiles across Astro, Hugo, and Statamic." activePath="/ssg/">
  <section class="page-intro">
    <p class="kicker">Static-generation profiles</p>
    <h1>Build the site. Keep the discussion.</h1>
    <p>SSG is a shared deployment capability—not a separate adapter. Astro provides the inaugural live foundation, Statamic SSG now proves the shared addon on generated output, and Hugo joins in late Alpha.</p>
  </section>
  <div class="demo-grid">{ssgDemos.map((demo) => <DemoCard demo={demo} />)}</div>
</DemoLayout>
