---
import type { Demo } from "../data/demo-estate";

const { demo } = Astro.props as { demo: Demo };
const stateClass = demo.state.toLowerCase().replaceAll(" ", "-");
---

<article class="demo-card">
  <div class="card-topline">
    <span class:list={["state", stateClass]}>{demo.state}</span>
    <code>{demo.origin}</code>
  </div>
  <h2>{demo.title}</h2>
  <p>{demo.description}</p>
  {demo.note && <p class="note">{demo.note}</p>}
  <div class="actions">
    {
      demo.href ? (
        <a class="button" href={demo.href}>Open demo</a>
      ) : (
        <span class="button disabled" aria-disabled="true">In development</span>
      )
    }
    {demo.discussionHref && <a class="text-link" href={demo.discussionHref}>Discussion</a>}
  </div>
</article>

<style>
  .demo-card { display: flex; min-height: 290px; flex-direction: column; gap: 14px; padding: clamp(20px, 3vw, 30px); border: 1px solid var(--line); border-radius: 22px; background: var(--panel); box-shadow: 0 18px 50px rgb(32 49 64 / 7%); }
  .card-topline { display: flex; align-items: center; justify-content: space-between; gap: 14px; }
  .state { padding: 5px 9px; border-radius: 999px; background: var(--accent-soft); color: var(--accent-strong); font-size: 0.7rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }
  .state.flagship { background: var(--gold-soft); color: var(--gold-strong); }
  .state.control { background: var(--slate-soft); color: var(--slate-strong); }
  .state.building-for-alpha { background: #e8f0ff; color: #24568d; }
  .state.live-refresh { background: #e8f6e8; color: #286534; }
  .state.future-edition { background: #f1f3f5; color: #5d6873; }
  code { overflow-wrap: anywhere; color: var(--muted); font-family: "Cascadia Code", "SFMono-Regular", Consolas, monospace; font-size: 0.72rem; text-align: right; }
  h2, p { margin: 0; }
  h2 { font-family: var(--display-font); font-size: clamp(1.45rem, 2vw, 1.8rem); line-height: 1.12; }
  p { color: var(--muted); }
  .note { padding-top: 12px; border-top: 1px solid var(--line); color: var(--ink-soft); font-size: 0.88rem; }
  .actions { display: flex; align-items: center; gap: 16px; margin-top: auto; padding-top: 8px; }
  .button, .text-link { font-weight: 800; }
  .button { display: inline-flex; min-height: 42px; align-items: center; padding: 9px 15px; border-radius: 10px; background: var(--accent); color: #fff; text-decoration: none; }
  .button.disabled { cursor: default; background: #e9edf0; color: #68737e; }
  .text-link { color: var(--accent-strong); text-underline-offset: 0.25em; }
  @media (max-width: 520px) { .card-topline { align-items: flex-start; flex-direction: column; } code { text-align: left; } }
</style>
