---

<nav class="social-icons" aria-label="DiscussionBridge community and social links">
  {links.map((item) => (
    <a href={item.href} aria-label={item.label} title={item.label}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><Fragment set:html={item.icon} /></svg>
    </a>
  ))}
</nav>

<style>
  .social-icons { display: flex; flex-wrap: wrap; gap: 8px; }
  .social-icons a { display: grid; width: 38px; height: 38px; place-items: center; border: 1px solid var(--line); border-radius: 50%; color: var(--accent-strong); background: var(--panel); transition: color .16s ease, border-color .16s ease, transform .16s ease, box-shadow .16s ease; }
  .social-icons a:hover { color: var(--accent); border-color: var(--accent); transform: translateY(-2px); box-shadow: 0 7px 18px rgb(17 106 123 / 16%); }
  .social-icons svg { width: 19px; height: 19px; fill: currentColor; }
</style>

